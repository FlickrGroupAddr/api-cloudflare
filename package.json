{
  "name": "fga-cloudflare-probes",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "check": "tsc --noEmit",
    "probe:build": "wrangler deploy --dry-run --config probes/runtime-permissions/wrangler.jsonc --outdir .probe-build",
    "route-conformance": "uv run --frozen python scripts/route_conformance.py run",
    "routes:test": "node --test probes/routes/registry.test.mjs",
    "secrets:test": "node --test probes/secrets/*.test.mjs",
    "native-secrets:test": "node --test probes/native-secrets/*.test.mjs",
    "api:test": "node --test tests/installations.test.mjs probes/foundation/*.test.mjs",
    "api:generate": "uv run --frozen python scripts/generate_api.py",
    "api:check-generated": "uv run --frozen python scripts/generate_api.py --check",
    "intake:test": "node --test tests/intake.test.mjs tests/flickr_reads.test.mjs",
    "admin:test": "node --test tests/admin_core.test.mjs tests/admin_runtime.test.mjs tests/flickr_oauth.test.mjs tests/google_identity.test.mjs tests/session_inventory.test.mjs",
    "cba:mutations": "uv run --frozen python scripts/cba_mutations.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260906.1",
    "@types/node": "24.13.4",
    "aws4fetch": "1.0.20",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "wrangler": "4.116.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  },
  "dependencies": {
    "cookie-es": "3.1.1",
    "csrf-sync": "4.2.1",
    "google-auth-library": "11.0.2",
    "hono": "4.13.7",
    "ipaddr.js": "2.2.0",
    "jose": "6.2.12",
    "oauth-1.0a": "2.2.6",
    "react-router": "8.3.1"
  }
}
