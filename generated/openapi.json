{
  "openapi": "3.2.0",
  "info": {
    "title": "FGA API backend: installation read slice",
    "version": "0.0.0"
  },
  "paths": {
    "/api/v001/installations/current": {
      "get": {
        "operationId": "installation_current",
        "summary": "Read the current installation",
        "description": "No query parameters or request body. Pending credentials authorize this safe read only. Credentials are canonical, opaque 64-character Crockford codes; their complete ASCII form is hashed for lookup. Missing authentication uses an empty 401 response.",
        "security": [
          {
            "installationBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current installation for the presented current or pending credential",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schemaVersion",
                    "installationId",
                    "installationRevision",
                    "installationState",
                    "presentedCredentialState"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "installationId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "installationRevision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "installationState": {
                      "const": "active"
                    },
                    "presentedCredentialState": {
                      "enum": [
                        "current",
                        "pending_rotation"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Application authentication-envelope errors use JSON/no-store and a matching Bearer challenge. ADR 0054 also permits an early provider HTTP 400 for duplicate Authorization fields before application execution to use the provider's non-JSON body without those headers; it cannot redirect, set an application/session cookie, serve the application shell or expose application/session data. The existing malformed-target exception remains.",
            "headers": {
              "Cache-Control": {
                "description": "Application-generated errors use no-store; the bounded early provider rejection may omit it.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Application-generated Bearer errors carry the matching error code. The early provider parser rejection may omit this header."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schemaVersion",
                    "error"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "retryable",
                        "correlationId"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retryable": {
                          "type": "boolean"
                        },
                        "correlationId": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing authentication has an empty body and a bare Bearer challenge; invalid credentials return the error representation.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer challenge with the same machine error code; absent error for missing authentication."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schemaVersion",
                    "error"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "retryable",
                        "correlationId"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retryable": {
                          "type": "boolean"
                        },
                        "correlationId": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Request rejected",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Allow": {
                "schema": {
                  "type": "string",
                  "const": "GET"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schemaVersion",
                    "error"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "retryable",
                        "correlationId"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retryable": {
                          "type": "boolean"
                        },
                        "correlationId": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Request rejected",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schemaVersion",
                    "error"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "retryable",
                        "correlationId"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retryable": {
                          "type": "boolean"
                        },
                        "correlationId": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "installationBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
