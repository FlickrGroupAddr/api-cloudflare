{
  "schemaVersion": 1,
  "scope": "installation-read-and-photo-admission",
  "routes": [
    {
      "id": "installation_current",
      "method": "GET",
      "pathPattern": "/api/v001/installations/current",
      "owner": "fga_api_backend",
      "routingClass": "worker_first",
      "probe": "missing_authentication",
      "expectedStatus": 401,
      "expectedChallenge": "Bearer realm=\"fga-api\"",
      "handler": "current",
      "auth": "installation_bearer",
      "allowPending": true,
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "installationId",
          "installationRevision",
          "installationState",
          "presentedCredentialState"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "installationId": {
            "type": "string",
            "minLength": 1
          },
          "installationRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "installationState": {
            "const": "active"
          },
          "presentedCredentialState": {
            "enum": [
              "current",
              "pending_rotation"
            ]
          }
        }
      },
      "successStatuses": [
        200
      ],
      "request": null
    },
    {
      "id": "existing_public_binding",
      "method": "POST",
      "pathPattern": "/api/v001/existing-public-photo-bindings",
      "owner": "fga_api_backend",
      "routingClass": "worker_first",
      "probe": "missing_authentication",
      "expectedStatus": 401,
      "expectedChallenge": "Bearer realm=\"fga-api\"",
      "handler": "binding",
      "auth": "installation_bearer",
      "allowPending": false,
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "fgaPhotoBindingId",
          "sourceKind",
          "flickrPhotoId",
          "linkedFlickrRevision",
          "verificationRevision",
          "verifiedAt"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "fgaPhotoBindingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,127}$"
          },
          "sourceKind": {
            "enum": [
              "fga_direct_upload",
              "existing_public_flickr_photo",
              "photographer_reconciled_ambiguous_upload"
            ]
          },
          "flickrPhotoId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,127}$"
          },
          "linkedFlickrRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "verificationRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "verifiedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
          }
        }
      },
      "successStatuses": [
        201,
        200
      ],
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "flickrPhotoId",
          "expectedLinkedFlickrRevision"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "flickrPhotoId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,127}$"
          },
          "expectedLinkedFlickrRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "id": "group_submission_batch",
      "method": "POST",
      "pathPattern": "/api/v001/group-submission-batches",
      "owner": "fga_api_backend",
      "routingClass": "worker_first",
      "probe": "missing_authentication",
      "expectedStatus": 401,
      "expectedChallenge": "Bearer realm=\"fga-api\"",
      "handler": "batch",
      "auth": "installation_bearer",
      "allowPending": false,
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "fgaPhotoBindingId",
          "flickrPhotoId",
          "submissions"
        ],
        "properties": {
          "schemaVersion": {
            "const": 2
          },
          "fgaPhotoBindingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,127}$"
          },
          "flickrPhotoId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,127}$"
          },
          "submissions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fgaSubmissionIntentId",
                "flickrGroupId",
                "state",
                "created",
                "permanentSubmissionBlock"
              ],
              "properties": {
                "fgaSubmissionIntentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,127}$"
                },
                "flickrGroupId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,127}$"
                },
                "state": {
                  "enum": [
                    "queued",
                    "attempting",
                    "retrying",
                    "throttled",
                    "added",
                    "moderation_submitted",
                    "delivery_uncertain",
                    "needs_attention",
                    "cancelled"
                  ]
                },
                "created": {
                  "type": "boolean"
                },
                "permanentSubmissionBlock": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "reasonCode",
                        "createdAt"
                      ],
                      "properties": {
                        "reasonCode": {
                          "type": "string",
                          "minLength": 1
                        },
                        "createdAt": {
                          "type": "string",
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "successStatuses": [
        202
      ],
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "photoBinding",
          "flickrGroupIds"
        ],
        "properties": {
          "schemaVersion": {
            "const": 2
          },
          "photoBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fgaPhotoBindingId",
              "expectedVerificationRevision"
            ],
            "properties": {
              "fgaPhotoBindingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,127}$"
              },
              "expectedVerificationRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          "flickrGroupIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,127}$"
            }
          }
        }
      }
    }
  ],
  "guards": [
    "/api",
    "/api/",
    "/healthz/"
  ],
  "proofEndpointsExcluded": true
}
