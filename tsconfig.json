{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "probes/runtime-permissions/worker.ts",
    "probes/runtime-permissions/cases.ts",
    "probes/routes/*.ts",
    "probes/secrets/*.ts",
    "probes/native-secrets/*.ts"
  ]
}
