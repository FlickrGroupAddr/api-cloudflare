{
  // Build template only: assign the private deployment database before deploying.
  "name": "fga-api-read-slice",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  // Explicit opt-in after provisioning/recovery verification; absent also fails closed.
  "vars": { "FGA_READ_ENABLED": "0" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "REPLACE_WITH_PRIVATE_DEPLOYMENT_DATABASE",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
