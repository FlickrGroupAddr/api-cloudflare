{
  "name": "fga-permissions-probe-unconfigured",
  "main": "worker.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "PROBE_RUN_ID": "unconfigured",
    "PROBE_MODE": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fga-permissions-probe-unconfigured",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE_OBJECT",
        "class_name": "PermissionProbeObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PermissionProbeObject"
      ]
    }
  ]
}
